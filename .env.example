# Groq
GROQ_API_KEY=your_groq_api_key_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# PostgreSQL
DATABASE_URL=postgresql://icebreaker:icebreaker@localhost:5433/icebreaker

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=profiles

# Redis
REDIS_URL=redis://localhost:6379

# App
MIN_POOL_SIZE=10
MAX_RETRIES=2
RATE_LIMIT_PER_MINUTE=30
TOP_N=5
NUM_QUESTIONS=5
QUALITY_THRESHOLD=0.7
DIVERSITY_THRESHOLD=0.97
MATCH_PCT_MIN=60
MATCH_PCT_MAX=98
PROFILE_MIN_CHARS=30
PROFILE_MAX_CHARS=500
EVENT_CREATE_INTERVAL_SECONDS=3600

# Groq model (default: llama-3.1-8b-instant — free tier)
GROQ_MODEL=llama-3.1-8b-instant

# CORS — comma-separated list of allowed frontend origins
# Local dev: leave as default. Production: set to your deployed URL, e.g. https://icebreaker.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
