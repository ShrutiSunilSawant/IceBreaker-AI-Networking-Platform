# Groq
GROQ_API_KEY=your_groq_api_key_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# PostgreSQL
DATABASE_URL=postgresql://icebreaker:icebreaker@localhost:5433/icebreaker

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=profiles

# Redis
REDIS_URL=redis://localhost:6379

# App
MIN_POOL_SIZE=10
MAX_RETRIES=2
RATE_LIMIT_PER_MINUTE=30

# CORS — comma-separated list of allowed frontend origins
# Local dev: leave as default. Production: set to your deployed URL, e.g. https://icebreaker.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
