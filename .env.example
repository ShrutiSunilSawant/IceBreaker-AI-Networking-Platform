# ── Environment ───────────────────────────────────────────────
# Set to "production" on Render, leave "development" locally
ENV=development

# ── Groq (free tier — https://console.groq.com) ───────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── PostgreSQL ────────────────────────────────────────────────
# Local dev: postgresql://icebreaker:icebreaker@localhost:5433/icebreaker
# Supabase:  get from Project Settings > Database > Connection string (Transaction mode)
DATABASE_URL=postgresql://icebreaker:icebreaker@localhost:5433/icebreaker

# ── Qdrant ───────────────────────────────────────────────────
# Local dev: localhost / 6333
# Qdrant Cloud: get host from https://cloud.qdrant.io (omit https://)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=profiles
# Required for Qdrant Cloud only:
# QDRANT_API_KEY=your_qdrant_cloud_api_key

# ── Redis ─────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Upstash:   get from https://console.upstash.com (use rediss:// URL)
REDIS_URL=redis://localhost:6379

# ── Email — Resend (free tier — https://resend.com) ──────────
# Leave blank in development (token shown in API response instead)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# ── App URLs ─────────────────────────────────────────────────
# Production frontend URL — used in password reset emails
APP_URL=https://your-app.onrender.com
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App settings ─────────────────────────────────────────────
MIN_POOL_SIZE=2
MAX_RETRIES=2
RATE_LIMIT_PER_MINUTE=30
EVENT_CREATE_INTERVAL_SECONDS=3600
RESET_TOKEN_EXPIRY_MINUTES=30
